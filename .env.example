# From Supabase: Project Settings -> API. Leave unset to run in demo mode (data stays in the browser).
# Use the publishable key (sb_publishable_...) or the legacy anon key. Never the service_role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: your custom domain, for absolute link-preview URLs. Vercel's own domain is detected automatically.
NEXT_PUBLIC_SITE_URL=
